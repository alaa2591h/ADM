
import { Palette, Spacing }                              from "../theme/globals.slint";
import { DialogPanel, DialogHeader, DialogField,
         DialogFooter }                                  from "../components/dialogs/dialog-base.slint";

export component AddDownloadDialog inherits Rectangle {
    // Use `visible` directly — no wrapper `shown` property that was never wired
    callback close;
    callback confirmed(string /* url */, string /* name */, string /* max-conn */);

    width: 100%; height: 100%;
    background: Palette.overlay;

    TouchArea { z: 0; clicked => { close(); } }

    DialogPanel {
        z: 1;
        x: (parent.width  - self.width)  / 2;
        y: (parent.height - self.height) / 2;
        panel-width: 480px;
        panel-height: 320px;

        VerticalLayout {
            spacing: 0;

            DialogHeader {
                title: "Add Download";
                title-icon: "＋";
                close-clicked => { close(); }
            }

            VerticalLayout {
                padding: Spacing.xl;
                spacing: Spacing.md;
                vertical-stretch: 1;

                url-f  := DialogField { field-label: "URL";                  placeholder: "https://…";                  }
                name-f := DialogField { field-label: "Save as (optional)";   placeholder: "Leave blank to auto-detect"; }
                conn-f := DialogField { field-label: "Max connections";       placeholder: "8"; input-type: InputType.number; }
            }

            DialogFooter {
                confirm-label: "Download";
                confirm-width: 110px;
                confirm-bg:    Palette.acc;
                cancel-clicked  => { close(); }
                confirm-clicked => {
                    if (url-f.value != "") {
                        confirmed(url-f.value, name-f.value, conn-f.value);
                        close();
                    }
                }
            }
        }
    }
}
