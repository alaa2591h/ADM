export global Palette {
    // Backgrounds (Midnight Slate)
    out property <color> b0:       #0a0b10; // Deepest background
    out property <color> b1:       #12131a; // Sidebar/Titlebar
    out property <color> b2:       #1a1b26; // Card background
    out property <color> b3:       #242638; // Hover state
    out property <color> b4:       #2d3047; // Active state
    out property <color> b5:       #363a5a; // Lighter accent

    // Accent Colors (Electric Blue / Cyan)
    out property <color> acc:      #3b82f6; // Primary blue
    out property <color> acc-dim:  #2563eb; // Dimmed blue
    out property <color> acc-glow: #3b82f644; // Accent glow effect

    // Text (Ice White / Slate Grey)
    out property <color> t1:       #f8fafc; // Main text
    out property <color> t2:       #94a3b8; // Secondary text
    out property <color> t3:       #64748b; // Muted text

    // Semantic Colors
    out property <color> grn:      #10b981; // Success/Resume
    out property <color> amb:      #f59e0b; // Warning/Retry
    out property <color> red:      #ef4444; // Error/Delete
    out property <color> cyn:      #06b6d4; // Info/Pause
    out property <color> pur:      #8b5cf6; // Feature
    out property <color> sched:    #a78bfa; // Scheduled

    // Borders & Dividers
    out property <color> bdr:      #1e293b; // Subtle border
    out property <color> bdr2:     #334155; // Stronger border
    out property <color> bdr3:     #3b82f6; // Focus border

    // Effects
    out property <color> overlay:  #000000aa;
    out property <color> shadow:   #00000088;
}
