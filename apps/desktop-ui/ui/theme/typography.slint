
export global Typography {
    // Font sizes
    out property <length> xs:   9px;
    out property <length> sm:  10px;
    out property <length> md:  11px;
    out property <length> base: 12px;
    out property <length> lg:  13px;
    out property <length> xl:  15px;
    out property <length> xxl: 18px;

    // Font weights (Slint uses int)
    out property <int> regular: 400;
    out property <int> medium:  500;
    out property <int> semi:    600;
    out property <int> bold:    700;
}
